{
  "name": "pullover",
  "productName": "Pullover",
  "version": "0.14.0",
  "description": "Menu-bar inbox for GitHub code review",
  "license": "MIT",
  "author": "Vlad Shilov",
  "repository": "github:omgovich/pullover",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:visual": "vitest run --project=visual",
    "docs:shots": "vitest run --project=docs -u",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --mac",
    "test:artifact-smoke": "node scripts/screenshot-artifact-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@octokit/graphql": "^9.0.5",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "1.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reshaped": "4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@octokit/request-error": "^7.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
